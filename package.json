{
  "name": "tiktok-quiz-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Automated TikTok quiz video factory built with Remotion, TypeScript and FFmpeg",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync": "tsx scripts/sync-episodes.ts",
    "studio": "npm run sync && remotion studio src/index.ts --public-dir=assets",
    "make": "tsx scripts/make.ts",
    "screenshot": "tsx scripts/screenshot.ts",
    "batch": "tsx scripts/batch.ts",
    "validate": "tsx scripts/validate.ts",
    "assets:audio": "tsx scripts/generate-audio.ts",
    "typecheck": "npm run sync && tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.534",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
